{
  "name": "@lawwu/html-server",
  "version": "0.14.0",
  "private": true,
  "description": "Host, version, search and link HTML pages and Markdown notes, like Quartz that also serves HTML.",
  "license": "MIT",
  "author": "Lawrence Wu",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "html-server": "src/cli.js"
  },
  "files": [
    "src",
    "public",
    "gallery",
    "cloudflare/*.js",
    "!cloudflare/files.generated.js",
    "wrangler.toml"
  ],
  "scripts": {
    "start": "node src/cli.js serve",
    "test": "node --test \"test/*.test.js\"",
    "site": "node scripts/build-site.js _site",
    "cf:dev": "npx --yes wrangler@4.147.0 dev",
    "cf:deploy": "node src/cli.js deploy cloudflare",
    "test:browser": "node --test test/browser.check.js"
  },
  "dependencies": {
    "marked": "18.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "parse5": "8.1.0",
    "playwright": "1.64.1"
  },
  "optionalDependencies": {
    "pg-native": "3.9.1"
  },
  "allowScripts": {
    "libpq": true
  }
}
