{
  "name": "@lawwu/html-server",
  "version": "0.9.0",
  "private": true,
  "description": "Host, version, search and link HTML pages and Markdown notes, like Quartz that also serves HTML. One dependency.",
  "license": "MIT",
  "author": "Lawrence Wu",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "html-server": "src/cli.js"
  },
  "files": [
    "src",
    "public",
    "gallery",
    "cloudflare/*.js",
    "!cloudflare/files.generated.js",
    "wrangler.toml"
  ],
  "scripts": {
    "start": "node src/cli.js serve",
    "test": "node --test \"test/*.test.js\"",
    "cf:dev": "npx --yes wrangler@4.147.0 dev",
    "cf:deploy": "node src/cli.js deploy cloudflare"
  },
  "dependencies": {
    "marked": "18.1.0"
  }
}
